# Database: Supabase PostgreSQL Connection String (Pooler / Session URI)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Security: Minimum 16 characters random secret (HMAC cookie signing)
SESSION_SECRET="replace-with-a-random-string-min-16-chars-for-hmac-sessions"

# Credential Encryption: 256-bit AES-GCM key for encrypted OAuth access tokens
SOCIAL_TOKEN_ENCRYPTION_KEY="replace-with-a-random-32-byte-secret-for-token-vault"

# Public Canonical URL (Required in Production: Vercel deployment domain)
# e.g. https://infurizz.vercel.app
APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Supabase Client SDK (Only needed if client-side Supabase features are used)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
