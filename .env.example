# ------------------------------------------------------------------------------
# INFURIZZ Platform Environment Configuration Template
# Copy this file to .env.local (or .env) and configure values for your environment.
# DO NOT commit real secrets or credentials to version control.
# ------------------------------------------------------------------------------

# Application Runtime Environment
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Dashboard -> Project Settings -> Database.
#
# DATABASE_URL:
#   Transaction pooler mode (port 6543) with PgBouncer.
#   Used by Prisma Client for application runtime queries.
#   Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL:
#   Direct session connection mode (port 5432).
#   Used by Prisma CLI for database pushes and migrations.
#   Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# Authentication Secrets
# ------------------------------------------------------------------------------
# NEXTAUTH_SECRET: A secure, random 32+ character string used for session tokens.
# Generate on CLI: openssl rand -base64 32
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-character-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Social Platform Integrations & Telemetry Guardrails
# ------------------------------------------------------------------------------
# CRITICAL BUSINESS RULE:
# In production, ENABLE_MOCK_SOCIAL_DATA must strictly be "false".
# When "false", social connectors only report live, verified data or display
# "Not Connected / API Unconfigured" status. Connectors will NEVER fabricate
# fake metrics, followers, or engagement numbers.
ENABLE_MOCK_SOCIAL_DATA="false"

# Meta Graph API (Instagram & Facebook)
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Google / YouTube Data API v3
YOUTUBE_API_KEY=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# X (Twitter API v2)
X_API_KEY=""
X_API_SECRET=""
X_BEARER_TOKEN=""

# LinkedIn Community / Marketing API
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# WhatsApp Business / Channel API
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# Google Stitch MCP Configuration
# ------------------------------------------------------------------------------
# If utilizing the Google Stitch MCP tool through Antigravity:
# Set your Stitch API key here or insert into local mcp_config.json
STITCH_API_KEY=""

# ------------------------------------------------------------------------------
# Future AI Intelligence Layer (Creator DNA, Compatibility & Opportunity Engine)
# ------------------------------------------------------------------------------
AI_GATEWAY_API_KEY=""
AI_MODEL="gemini-1.5-pro"

# ------------------------------------------------------------------------------
# Demo Seeding Safeguard
# ------------------------------------------------------------------------------
# Demo seeding is disabled by default to protect production Supabase data.
# Leave unset or "false". Seeding script will refuse execution unless explicitly "true".
ALLOW_DEMO_SEED="false"
